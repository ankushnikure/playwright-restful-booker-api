{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "outDir": "./dist",
        "baseUrl": "./src",
        "types": ["node", "@playwright/test"],
        "paths": {
            "@api/*": ["api/*"],
            "@auth/*": ["auth/*"],
            "@config/*": ["config/*"],
            "@constants/*": ["constants/*"],
            "@fixtures/*": ["fixtures/*"],
            "@schemas/*": ["schemas/*"],
            "@testdata/*": ["test-data/*"],
            "@utils/*": ["utils/*"]
        }
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
