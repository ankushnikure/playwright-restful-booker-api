{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM"],
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "outDir": "./dist",
        "baseUrl": ".",
        "types": ["node", "@playwright/test"],
        "paths": {
            "@api/*": ["src/api/*"],
            "@auth/*": ["src/auth/*"],
            "@config/*": ["src/config/*"],
            "@fixtures/*": ["src/fixtures/*"],
            "@schemas/*": ["src/schemas/*"],
            "@testdata/*": ["src/testdata/*"],
            "@utils/*": ["src/utils/*"]
        }
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
